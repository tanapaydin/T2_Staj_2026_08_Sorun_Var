DATABASE_URL=postgresql://postgres:postgres@db:5432/sorunburada
JWT_SECRET_KEY=replace_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Resend (preferred). The sender must belong to a domain verified in Resend.
RESEND_API_KEY=re_replace_with_your_api_key
EMAIL_FROM=Sorun Var <noreply@yourdomain.com>

# Optional SMTP fallback. For Gmail, use a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace_with_provider_app_password
SMTP_FROM=you@example.com
